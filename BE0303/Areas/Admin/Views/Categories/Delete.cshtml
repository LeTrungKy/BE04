@model BE0303.Models.Category

@{
    ViewBag.Title = "Xóa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-danger">
    <div class="panel-heading">
        <h3 class="panel-title">Xóa danh mục sản phẩm</h3>
    </div>
    <div class="panel-body">
        <h4>Bạn có chắc chắn muốn xóa danh mục này không?</h4>
        <hr />
        <dl class="dl-horizontal">
            <dt>Tên danh mục</dt>
            <dd>@Html.DisplayFor(model => model.CategoryName)</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color">
                <input type="submit" value="Xóa" class="btn btn-danger" />
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
            </div>
        }
    </div>
</div>
