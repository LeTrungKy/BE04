@model BE0303.Models.ViewModel.ProductSearchVM
@using PagedList
@using PagedList.Mvc

@if (Model.Products.Count == 0)
{
    <div class="alert alert-warning">Không tìm thấy sản phẩm nào phù hợp.</div>
}
else
{
    <table class="table table-bordered table-striped table-hover">
        <thead>
            <tr style="background-color:#337ab7; color:#fff;">
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Danh mục</th>
                <th>Giá</th>
                <th style="width:260px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Products)
            {
                <tr>
                    <td>
                        <img src="@Url.Content(string.IsNullOrEmpty(item.ProductImage) ? "~/Content/images/default_img.png" : item.ProductImage)"
                             alt="Ảnh sản phẩm" style="height:60px;" class="img-thumbnail" />
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.ProductName)</td>
                    <td>@Html.DisplayFor(modelItem => item.Category.CategoryName)</td>
                    <td>@item.ProductPrice.ToString("N0") đ</td>
                    <td>
                        @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-warning btn-sm" })
                        @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-info btn-sm" })
                        @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div>
        Trang @(Model.Products.PageCount < Model.Products.PageNumber ? 0 : Model.Products.PageNumber) / @Model.Products.PageCount
        (tổng cộng @Model.Products.TotalItemCount sản phẩm)
    </div>

    @* Giữ lại tiêu chí tìm kiếm và sắp xếp khi chuyển trang *@
    @Html.PagedListPager(Model.Products,
        page => Url.Action("Index", new
        {
            page = page,
            searchTerm = Model.SearchTerm,
            minPrice = Model.MinPrice,
            maxPrice = Model.MaxPrice,
            sortOrder = Model.SortOrder
        }),
        PagedListRenderOptions.ClassicPlusFirstAndLast)
}
