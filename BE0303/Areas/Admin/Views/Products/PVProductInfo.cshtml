@model BE0303.Models.Product

<dl class="dl-horizontal">
    <dt>Danh mục</dt>
    <dd>@Html.DisplayFor(model => model.Category.CategoryName)</dd>

    <dt>Tên sản phẩm</dt>
    <dd>@Html.DisplayFor(model => model.ProductName)</dd>

    <dt>Mô tả</dt>
    <dd>@Html.DisplayFor(model => model.ProductDescription)</dd>

    <dt>Giá</dt>
    <dd>@Model.ProductPrice.ToString("N0") đ</dd>

    <dt>Hình ảnh</dt>
    <dd>
        <img src="@Url.Content(string.IsNullOrEmpty(Model.ProductImage) ? "~/Content/images/default_img.png" : Model.ProductImage)"
             alt="Ảnh sản phẩm" style="max-height:150px;" class="img-thumbnail" />
    </dd>
</dl>
