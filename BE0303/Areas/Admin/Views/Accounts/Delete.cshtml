@model BE0303.Models.User

@{
    ViewBag.Title = "Xóa tài khoản Admin";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-danger">
    <div class="panel-heading">
        <h3 class="panel-title">Xóa tài khoản Admin</h3>
    </div>
    <div class="panel-body">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <h4>Bạn có chắc chắn muốn xóa tài khoản này không?</h4>
        <hr />
        <dl class="dl-horizontal">
            <dt>Tên đăng nhập</dt>
            <dd>@Model.Username</dd>

            <dt>Vai trò</dt>
            <dd>@(Model.UserRole == null ? "" : Model.UserRole.Trim())</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color">
                <input type="submit" value="Xóa" class="btn btn-danger" />
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
            </div>
        }
    </div>
</div>
