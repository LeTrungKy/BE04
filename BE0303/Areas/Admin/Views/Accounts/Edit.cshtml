@model BE0303.Models.User

@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel panel-warning">
    <div class="panel-heading">
        <h3 class="panel-title">Đổi mật khẩu tài khoản Admin</h3>
    </div>
    <div class="panel-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.Username)

                <div class="form-group">
                    <label class="control-label col-md-2">Tên đăng nhập</label>
                    <div class="col-md-10">
                        <p class="form-control-static"><strong>@Model.Username</strong></p>
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-2" for="Password">Mật khẩu mới</label>
                    <div class="col-md-10">
                        @Html.PasswordFor(model => model.Password, new { @class = "form-control" })
                        <span class="help-block">Để trống nếu không muốn đổi mật khẩu.</span>
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Lưu" class="btn btn-warning" />
                        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            </div>
        }
    </div>
</div>
